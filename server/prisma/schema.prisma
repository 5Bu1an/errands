// Shared: all database tables live here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// US-12: one row per person. id is the SAME id as their Supabase Auth account.
model User {
  id        String   @id @db.Uuid
  name      String?
  program   String?
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

