{
  "name": "errands-server",
  "private": true,
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "lint": "echo \"lint not configured yet\"",
    "test": "jest --passWithNoTests",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv run -q -f ../.env -- prisma migrate dev",
    "db:studio": "dotenv run -q -f ../.env -- prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.7",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.3.1"
  }
}
